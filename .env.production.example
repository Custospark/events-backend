APP_NAME="Custospark Events"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://events-api.custospark.com

APP_VERSION=0.1.0
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=custospark_events
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.custospark.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@custospark.com"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://events.custospark.com
CORS_ALLOWED_ORIGINS=https://events.custospark.com
CORS_MAX_AGE=3600
SANCTUM_STATEFUL_DOMAINS=events.custospark.com,events-api.custospark.com

APP_FORCE_HTTPS=true
TRUSTED_PROXIES=127.0.0.1,::1

TENANT_DOMAIN_SUFFIX=custospark.events
PLATFORM_ADMIN_EMAILS=oscar@custospark.com

CUSTOSPARK_API_URL=https://api.custospark.com
CUSTOSPARK_API_KEY=
CUSTOSPARK_WEBHOOK_SECRET=
CUSTOSPARK_COMMISSION_PERCENT=5

PESAPAL_ENABLED=true
PESAPAL_ENVIRONMENT=production
PESAPAL_BYPASS=false
PESAPAL_SANDBOX_CONSUMER_KEY=
PESAPAL_SANDBOX_CONSUMER_SECRET=
PESAPAL_PRODUCTION_CONSUMER_KEY=
PESAPAL_PRODUCTION_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=${APP_URL}/api/v1/payments/callback
PESAPAL_IPN_URL=${APP_URL}/api/v1/payments/ipn
PESAPAL_IPN_ID=
